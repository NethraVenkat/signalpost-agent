# Template synthesis is the default. No .env loader is used.
SIGNALPOST_LLM_PROVIDER=
SIGNALPOST_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
